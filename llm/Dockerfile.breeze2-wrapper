# syntax=docker/dockerfile:1.7
FROM nvcr.io/nvidia/pytorch:26.03-py3

ENV DEBIAN_FRONTEND=noninteractive

RUN python3 -m pip install --no-cache-dir --upgrade pip

RUN python3 -m pip install --no-cache-dir \
    accelerate \
    fastapi \
    "huggingface_hub>=0.28" \
    mtkresearch \
    protobuf \
    safetensors \
    sentencepiece \
    "transformers==4.47.0" \
    timm \
    uvicorn

WORKDIR /app

ARG LLM_MODEL=MediaTek-Research/Llama-Breeze2-8B-Instruct
ARG MODEL_DIR=/models/llama-breeze2-8b-instruct

ENV MODEL_ID=${LLM_MODEL}
ENV MODEL_PATH=${MODEL_DIR}

RUN --mount=type=secret,id=hf_token \
    python3 -c "from pathlib import Path; from huggingface_hub import snapshot_download; token_path = Path('/run/secrets/hf_token'); token = token_path.read_text().strip() if token_path.exists() else None; snapshot_download('${LLM_MODEL}', token=token, local_dir='${MODEL_DIR}', local_dir_use_symlinks=False)"

ENV HF_TOKEN=""
ENV IMG_CONTEXT_TOKEN_ID=128212
ENV DEFAULT_MAX_NEW_TOKENS=2048
ENV DEFAULT_TEMPERATURE=0.3

COPY llm/breeze2_wrapper/ ./breeze2_wrapper/

EXPOSE 8001

CMD ["uvicorn", "breeze2_wrapper.app:app", "--host", "0.0.0.0", "--port", "8001"]
