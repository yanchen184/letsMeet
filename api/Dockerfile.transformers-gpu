FROM nvcr.io/nvidia/pytorch:26.03-py3

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install --no-cache-dir --upgrade pip

RUN useradd -m -s /bin/bash appuser

WORKDIR /app

COPY api/requirements.txt .
RUN python3 -m pip install --no-cache-dir -r requirements.txt \
    && python3 -m pip install --no-cache-dir \
      accelerate \
      librosa \
      sentencepiece \
      soundfile \
      "transformers>=4.46,<5"

RUN mkdir -p /home/appuser/.cache/huggingface \
    && chown -R appuser:appuser /home/appuser/.cache

USER appuser

ENV HF_HOME=/home/appuser/.cache/huggingface \
    ASR_BACKEND=transformers \
    DEVICE=auto \
    COMPUTE_TYPE=float16 \
    STREAM_MODEL=openai/whisper-small

ARG STREAM_MODEL=openai/whisper-small
ARG EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
ARG HF_TOKEN
ENV STREAM_MODEL=${STREAM_MODEL} \
    EMBEDDING_MODEL=${EMBEDDING_MODEL} \
    HF_TOKEN=${HF_TOKEN}

RUN python3 - <<'PY'
import os
from huggingface_hub import snapshot_download

token = os.environ.get("HF_TOKEN") or None
snapshot_download(os.environ["STREAM_MODEL"], token=token)
snapshot_download(os.environ["EMBEDDING_MODEL"], token=token)
PY

COPY --chown=appuser:appuser api/app/ app/
COPY --chown=appuser:appuser api/data/ data/

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
